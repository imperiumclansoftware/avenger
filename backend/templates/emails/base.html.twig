<!doctype html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#eef1f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1b1f2a;">
  <table role="presentation" width="100%" style="max-width:580px;margin:0 auto;background:#ffffff;border:1px solid #d6dcea;border-radius:10px;">
    <tr>
      <td style="padding:18px 28px;background:#0b1222;border-radius:10px 10px 0 0;">
        <strong style="font-size:19px;color:#ffffff;letter-spacing:0.5px;"><span style="color:#5c9bff;">&lt;/&gt;</span> Avenger</strong>
      </td>
    </tr>
    <tr>
      <td style="padding:24px 28px;font-size:16px;line-height:1.55;">
        {% if recipientName %}<p style="margin-top:0;">Bonjour {{ recipientName }},</p>{% else %}<p style="margin-top:0;">Bonjour,</p>{% endif %}
        {% block content %}{% endblock %}
      </td>
    </tr>
    <tr>
      <td style="padding:14px 28px;border-top:1px solid #e3e7f0;font-size:12px;color:#5e6577;">
        {% block footer %}E-mail automatique envoyé par Avenger.{% endblock %}
      </td>
    </tr>
  </table>
</body>
</html>
