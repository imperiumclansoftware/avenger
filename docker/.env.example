# Avenger: copy to .env next to compose.yaml (or enter these variables in a Portainer stack).

# Password of the PostgreSQL database (required): openssl rand -hex 32. Keep it.
POSTGRES_PASSWORD=
# Port published on the host
AVENGER_PORT=8080
# Image tag (latest, or a version such as 1.0.0)
AVENGER_VERSION=latest

# Optional: generated on the first start and kept in the volume /data/secrets when empty
APP_SECRET=
JWT_PASSPHRASE=
# Behind a reverse proxy: its addresses (e.g. 172.16.0.0/12), for the visitors' real IP
TRUSTED_PROXIES=
