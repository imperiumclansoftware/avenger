# Avenger: everything is optional. Copy to .env next to compose.yaml only to change a value
# (or enter these variables in a Portainer stack).

# Port published on the host
AVENGER_PORT=8080
# Image tag (latest, or a version such as 0.3.0)
AVENGER_VERSION=latest
# Behind a reverse proxy: its addresses (e.g. 172.16.0.0/12), for the visitors' real IP
TRUSTED_PROXIES=

# Secrets: generated on the first start and kept in the avenger_data volume (/data/secrets).
# Set them only to choose them yourself, before the first start (or to recover an installation).
APP_SECRET=
JWT_PASSPHRASE=
POSTGRES_PASSWORD=
